# Copy this file to .env and fill in your real values.
# .env is git-ignored and should NEVER be committed.

# GitHub Personal Access Token (fine-grained, scoped to the target repo only)
GITHUB_TOKEN=your_github_token_here

# The repo this agent will monitor, in "owner/repo" format
GITHUB_REPO=gangadhara18/pr-triage-agent-testbed

# Claude API key
ANTHROPIC_API_KEY=your_claude_api_key_here

# PostgreSQL connection string for the Phase 2 dashboard
# Format: postgresql://<username>:<password>@localhost:5432/<database_name>
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/pr_triage
